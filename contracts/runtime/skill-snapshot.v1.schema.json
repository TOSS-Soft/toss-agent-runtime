{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/runtime/v1/skill-snapshot.v1.schema.json",
  "title": "TOSS skill snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "schema_version",
    "document_type",
    "descriptor",
    "skill_markdown_hash",
    "skill_markdown_bytes",
    "resources",
    "package_hash",
    "total_bytes",
    "document_hash"
  ],
  "properties": {
    "protocol_version": { "const": "runtime-contract.v1" },
    "schema_version": { "const": "skill-snapshot.v1" },
    "document_type": { "const": "skill-snapshot" },
    "descriptor": { "$ref": "skill-descriptor.v1.schema.json" },
    "skill_markdown_hash": { "$ref": "runtime-common.v1.schema.json#/$defs/sha256" },
    "skill_markdown_bytes": { "type": "integer", "minimum": 1, "maximum": 524288 },
    "resources": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/resource" } },
    "package_hash": { "$ref": "runtime-common.v1.schema.json#/$defs/sha256" },
    "total_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
    "document_hash": { "$ref": "runtime-common.v1.schema.json#/$defs/sha256" }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "phases", "priority", "media_type", "bytes", "hash"],
      "properties": {
        "path": { "$ref": "runtime-common.v1.schema.json#/$defs/relative_location" },
        "role": { "enum": ["reference", "asset", "script"] },
        "phases": {
          "type": "array",
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "BRAINSTORMING",
              "TEST_DESIGN",
              "RED",
              "GREEN",
              "DEBUGGING",
              "REVIEW",
              "VERIFICATION"
            ]
          }
        },
        "priority": { "type": ["integer", "null"], "minimum": 0, "maximum": 255 },
        "media_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 127,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*$"
        },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 2097152 },
        "hash": { "$ref": "runtime-common.v1.schema.json#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "role": { "const": "reference" } } },
          "then": { "properties": { "phases": { "type": "array", "minItems": 1 } } },
          "else": {
            "properties": {
              "phases": { "type": "array", "maxItems": 0 },
              "priority": { "const": null }
            }
          }
        }
      ]
    }
  }
}
