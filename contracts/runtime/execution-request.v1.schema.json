{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/runtime/v1/execution-request.v1.schema.json",
  "title": "TOSS Runtime execution request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "schema_version",
    "document_type",
    "request_id",
    "run_id",
    "created_at",
    "deadline",
    "task_contract",
    "input_artifacts",
    "agent",
    "model",
    "superpowers",
    "mcp",
    "budget",
    "review_policy",
    "output",
    "trace"
  ],
  "properties": {
    "protocol_version": { "const": "runtime-contract.v1" },
    "schema_version": { "const": "execution-request.v1" },
    "document_type": { "const": "execution-request" },
    "request_id": {
      "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/identifier"
    },
    "created_at": {
      "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/utc_timestamp"
    },
    "deadline": {
      "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/utc_timestamp"
    },
    "task_contract": {
      "allOf": [
        {
          "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/artifact_reference"
        },
        {
          "type": "object",
          "properties": { "document_type": { "const": "task-contract" } }
        }
      ]
    },
    "input_artifacts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/artifact_reference"
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition", "role"],
      "properties": {
        "definition": {
          "allOf": [
            {
              "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/artifact_reference"
            },
            {
              "type": "object",
              "properties": { "document_type": { "const": "agent-definition" } }
            }
          ]
        },
        "role": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_class", "required_capabilities"],
      "properties": {
        "logical_class": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
        }
      }
    },
    "superpowers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,127}$" }
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": {
          "allOf": [
            {
              "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/artifact_reference"
            },
            {
              "type": "object",
              "properties": { "document_type": { "const": "mcp-profile" } }
            }
          ]
        }
      }
    },
    "budget": {
      "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/budget"
    },
    "review_policy": {
      "allOf": [
        {
          "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/artifact_reference"
        },
        {
          "type": "object",
          "properties": { "document_type": { "const": "review-policy" } }
        }
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema"],
      "properties": {
        "schema": {
          "allOf": [
            {
              "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/artifact_reference"
            },
            {
              "type": "object",
              "properties": { "document_type": { "const": "output-schema" } }
            }
          ]
        }
      }
    },
    "trace": {
      "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/trace_context"
    }
  }
}
