{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/runtime/v1/routing-state.v1.schema.json",
  "title": "TOSS routing state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "schema_version",
    "document_type",
    "state_id",
    "revision",
    "previous_state_hash",
    "run_id",
    "request_hash",
    "catalog_hash",
    "policy_hash",
    "budget",
    "settled",
    "budget_status",
    "reservations",
    "circuits",
    "document_hash"
  ],
  "properties": {
    "protocol_version": { "const": "runtime-contract.v1" },
    "schema_version": { "const": "routing-state.v1" },
    "document_type": { "const": "routing-state" },
    "state_id": { "$ref": "#/$defs/identifier" },
    "revision": { "$ref": "#/$defs/positive_safe_integer" },
    "previous_state_hash": {
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "run_id": { "$ref": "#/$defs/identifier" },
    "request_hash": { "$ref": "#/$defs/sha256" },
    "catalog_hash": { "$ref": "#/$defs/sha256" },
    "policy_hash": { "$ref": "#/$defs/sha256" },
    "budget": {
      "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/budget"
    },
    "settled": {
      "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/usage"
    },
    "budget_status": { "type": "string", "enum": ["known", "unknown"] },
    "reservations": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/reservation" }
    },
    "circuits": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/circuit" }
    },
    "document_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "identifier": {
      "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/identifier"
    },
    "sha256": {
      "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/sha256"
    },
    "timestamp": {
      "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/utc_timestamp"
    },
    "positive_safe_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nonnegative_safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "entry_id",
        "role",
        "input_tokens",
        "output_tokens",
        "cost_microusd",
        "duration_ms",
        "turns"
      ],
      "properties": {
        "attempt_id": { "$ref": "#/$defs/identifier" },
        "entry_id": { "$ref": "#/$defs/identifier" },
        "role": { "type": "string", "enum": ["reviewer", "worker"] },
        "input_tokens": { "$ref": "#/$defs/nonnegative_safe_integer" },
        "output_tokens": { "$ref": "#/$defs/nonnegative_safe_integer" },
        "cost_microusd": { "$ref": "#/$defs/nonnegative_safe_integer" },
        "duration_ms": { "$ref": "#/$defs/nonnegative_safe_integer" },
        "turns": { "const": 1 }
      }
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "decision_hash", "request_id", "allocations", "created_at"],
      "properties": {
        "decision_id": { "$ref": "#/$defs/identifier" },
        "decision_hash": { "$ref": "#/$defs/sha256" },
        "request_id": { "$ref": "#/$defs/identifier" },
        "allocations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 17,
          "items": { "$ref": "#/$defs/allocation" }
        },
        "created_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "closed_circuit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "status", "consecutive_failures", "retry_at", "probe_decision_id"],
      "properties": {
        "entry_id": { "$ref": "#/$defs/identifier" },
        "status": { "const": "closed" },
        "consecutive_failures": { "$ref": "#/$defs/nonnegative_safe_integer" },
        "retry_at": { "type": "null" },
        "probe_decision_id": { "type": "null" }
      }
    },
    "open_circuit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "status", "consecutive_failures", "retry_at", "probe_decision_id"],
      "properties": {
        "entry_id": { "$ref": "#/$defs/identifier" },
        "status": { "const": "open" },
        "consecutive_failures": { "$ref": "#/$defs/positive_safe_integer" },
        "retry_at": { "$ref": "#/$defs/timestamp" },
        "probe_decision_id": { "type": "null" }
      }
    },
    "probe_reserved_circuit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "status", "consecutive_failures", "retry_at", "probe_decision_id"],
      "properties": {
        "entry_id": { "$ref": "#/$defs/identifier" },
        "status": { "const": "probe-reserved" },
        "consecutive_failures": { "$ref": "#/$defs/positive_safe_integer" },
        "retry_at": { "$ref": "#/$defs/timestamp" },
        "probe_decision_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "circuit": {
      "oneOf": [
        { "$ref": "#/$defs/closed_circuit" },
        { "$ref": "#/$defs/open_circuit" },
        { "$ref": "#/$defs/probe_reserved_circuit" }
      ]
    }
  }
}
