{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/runtime/v1/service-control-response.v1.schema.json",
  "title": "TOSS local runtime service control response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "request_id", "ok", "status", "data", "error"],
  "properties": {
    "schema_version": { "const": "service-control-response.v1" },
    "document_type": { "const": "service-control-response" },
    "request_id": { "type": ["string", "null"], "format": "uuid" },
    "ok": { "type": "boolean" },
    "status": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "package_version",
        "service_instance_id",
        "pid",
        "started_at",
        "health",
        "accepting"
      ],
      "properties": {
        "package_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "service_instance_id": { "type": "string", "format": "uuid" },
        "pid": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "started_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "health": { "type": "string", "enum": ["healthy", "degraded", "stopping"] },
        "accepting": { "type": "boolean" }
      }
    },
    "data": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/project_registration_data" },
        { "$ref": "#/$defs/project_list_data" },
        { "$ref": "#/$defs/superpowers_approval_data" },
        { "$ref": "#/$defs/tool_approval_data" }
      ]
    },
    "error": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/service_error" }]
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" },
    "positive_integer": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "journal_head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journal_revision", "sequence", "entry_hash"],
      "properties": {
        "journal_revision": { "$ref": "#/$defs/positive_integer" },
        "sequence": { "$ref": "#/$defs/positive_integer" },
        "entry_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "phase": {
      "enum": [
        "BRAINSTORMING",
        "TEST_DESIGN",
        "RED",
        "GREEN",
        "DEBUGGING",
        "REVIEW",
        "VERIFICATION"
      ]
    },
    "project_registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "registry_revision", "canonical_root", "manifest_hash", "state"],
      "properties": {
        "project_id": { "type": "string", "format": "uuid" },
        "registry_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "canonical_root": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "manifest_hash": { "$ref": "#/$defs/sha256" },
        "state": {
          "type": "string",
          "enum": ["ACTIVE", "UNREGISTERED", "BLOCKED_PROJECT_UNAVAILABLE"]
        }
      }
    },
    "project_registration_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "registration"],
      "properties": {
        "kind": { "const": "project-registration" },
        "registration": { "$ref": "#/$defs/project_registration" }
      }
    },
    "project_list_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "registrations"],
      "properties": {
        "kind": { "const": "project-list" },
        "registrations": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/project_registration" }
        }
      }
    },
    "superpowers_approval_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "run_id",
        "state",
        "phase",
        "journal_head",
        "approval_request_hash",
        "approval_decision_hash",
        "replayed"
      ],
      "properties": {
        "kind": { "const": "superpowers-approval" },
        "run_id": { "$ref": "#/$defs/identifier" },
        "state": { "enum": ["RUNNING", "BLOCKED"] },
        "phase": { "$ref": "#/$defs/phase" },
        "journal_head": { "$ref": "#/$defs/journal_head" },
        "approval_request_hash": { "$ref": "#/$defs/sha256" },
        "approval_decision_hash": { "$ref": "#/$defs/sha256" },
        "replayed": { "type": "boolean" }
      }
    },
    "tool_approval_data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "run_id",
        "state",
        "call_id",
        "journal_head",
        "approval_request_hash",
        "approval_decision_hash",
        "replayed"
      ],
      "properties": {
        "kind": { "const": "tool-approval" },
        "run_id": { "$ref": "#/$defs/identifier" },
        "state": { "enum": ["RUNNING", "BLOCKED"] },
        "call_id": { "$ref": "#/$defs/identifier" },
        "journal_head": { "$ref": "#/$defs/journal_head" },
        "approval_request_hash": { "$ref": "#/$defs/sha256" },
        "approval_decision_hash": { "$ref": "#/$defs/sha256" },
        "replayed": { "type": "boolean" }
      }
    },
    "service_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "retryable", "safe_message"],
      "properties": {
        "code": { "type": "string" },
        "category": { "type": "string" },
        "retryable": { "type": "boolean" },
        "safe_message": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "oneOf": [
        {
          "properties": {
            "code": { "const": "RUNTIME_SERVICE_ALREADY_RUNNING" },
            "category": { "const": "unavailable" },
            "retryable": { "const": false },
            "safe_message": { "const": "Runtime service is already running" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SERVICE_LOCK_AMBIGUOUS" },
            "category": { "const": "integrity" },
            "retryable": { "const": false },
            "safe_message": { "const": "Runtime service lock state is ambiguous" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SERVICE_PATH_UNSAFE" },
            "category": { "const": "integrity" },
            "retryable": { "const": false },
            "safe_message": { "const": "Runtime service path is unsafe" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SERVICE_DEFINITION_UNSAFE" },
            "category": { "const": "integrity" },
            "retryable": { "const": false },
            "safe_message": { "const": "Runtime service definition is unsafe" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SERVICE_MANAGER_UNAVAILABLE" },
            "category": { "const": "unavailable" },
            "retryable": { "const": false },
            "safe_message": { "const": "Runtime service manager is unavailable" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SERVICE_MANAGER_FAILED" },
            "category": { "const": "unavailable" },
            "retryable": { "const": true },
            "safe_message": { "const": "Runtime service manager failed" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SERVICE_CONTROL_INVALID" },
            "category": { "const": "invalid-input" },
            "retryable": { "const": false },
            "safe_message": { "const": "Runtime service control request is invalid" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SERVICE_CONTROL_CONFLICT" },
            "category": { "const": "stale-revision" },
            "retryable": { "const": false },
            "safe_message": {
              "const": "Runtime service control request conflicts with an existing request"
            }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SERVICE_UNAVAILABLE" },
            "category": { "const": "unavailable" },
            "retryable": { "const": true },
            "safe_message": { "const": "Runtime service is unavailable" }
          }
        },
        {
          "properties": {
            "code": { "const": "BLOCKED_SUPERPOWERS_MISSING" },
            "category": { "const": "unsupported-capability" },
            "retryable": { "const": false },
            "safe_message": { "const": "Required Superpowers skill is unavailable" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SKILL_INVALID" },
            "category": { "const": "invalid-input" },
            "retryable": { "const": false },
            "safe_message": { "const": "Skill input is invalid" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SKILL_PATH_UNSAFE" },
            "category": { "const": "integrity" },
            "retryable": { "const": false },
            "safe_message": { "const": "Skill path is unsafe" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SKILL_INTEGRITY" },
            "category": { "const": "integrity" },
            "retryable": { "const": false },
            "safe_message": { "const": "Skill integrity check failed" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SKILL_LIMIT_EXCEEDED" },
            "category": { "const": "policy-denied" },
            "retryable": { "const": false },
            "safe_message": { "const": "Skill limit is exceeded" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SKILL_CONTEXT_OVERFLOW" },
            "category": { "const": "policy-denied" },
            "retryable": { "const": false },
            "safe_message": { "const": "Skill context exceeds its configured limit" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SKILL_SCRIPT_UNAVAILABLE" },
            "category": { "const": "unsupported-capability" },
            "retryable": { "const": false },
            "safe_message": { "const": "Skill script is unavailable" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SKILL_STALE_STATE" },
            "category": { "const": "stale-revision" },
            "retryable": { "const": false },
            "safe_message": { "const": "Skill state is stale" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SKILL_OPERATION_CONFLICT" },
            "category": { "const": "stale-revision" },
            "retryable": { "const": false },
            "safe_message": { "const": "Skill operation conflicts with an existing operation" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SKILL_UNAVAILABLE" },
            "category": { "const": "unavailable" },
            "retryable": { "const": true },
            "safe_message": { "const": "Skill is unavailable" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_TOOL_INVALID" },
            "category": { "const": "invalid-input" },
            "retryable": { "const": false },
            "safe_message": { "const": "Tool input is invalid" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_TOOL_SCHEMA_MISMATCH" },
            "category": { "const": "integrity" },
            "retryable": { "const": false },
            "safe_message": { "const": "Tool schema does not match its profile" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_TOOL_PROTOCOL_DOWNGRADE" },
            "category": { "const": "integrity" },
            "retryable": { "const": false },
            "safe_message": { "const": "Tool protocol revision was downgraded" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_TOOL_RESULT_INVALID" },
            "category": { "const": "integrity" },
            "retryable": { "const": false },
            "safe_message": { "const": "Tool result is invalid" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_TOOL_POLICY_DENIED" },
            "category": { "const": "policy-denied" },
            "retryable": { "const": false },
            "safe_message": { "const": "Tool call is denied by policy" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_TOOL_UNSUPPORTED" },
            "category": { "const": "unsupported-capability" },
            "retryable": { "const": false },
            "safe_message": { "const": "Tool capability is unsupported" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_TOOL_OPERATION_CONFLICT" },
            "category": { "const": "stale-revision" },
            "retryable": { "const": false },
            "safe_message": {
              "const": "Tool operation conflicts with an existing operation"
            }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_TOOL_APPROVAL_REQUIRED" },
            "category": { "const": "approval-required" },
            "retryable": { "const": false },
            "safe_message": { "const": "Tool call requires human approval" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_TOOL_APPROVAL_STALE" },
            "category": { "const": "stale-revision" },
            "retryable": { "const": false },
            "safe_message": { "const": "Tool approval is stale" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_TOOL_APPROVAL_REJECTED" },
            "category": { "const": "policy-denied" },
            "retryable": { "const": false },
            "safe_message": { "const": "Tool approval was rejected" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_TOOL_EFFECT_UNCERTAIN" },
            "category": { "const": "integrity" },
            "retryable": { "const": false },
            "safe_message": { "const": "Tool effect is uncertain" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_TOOL_AUTHENTICATION" },
            "category": { "const": "authentication" },
            "retryable": { "const": false },
            "safe_message": { "const": "Tool authentication failed" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_TOOL_UNAVAILABLE" },
            "category": { "const": "unavailable" },
            "retryable": { "const": true },
            "safe_message": { "const": "Tool service is unavailable" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_TOOL_RATE_LIMIT" },
            "category": { "const": "rate-limit" },
            "retryable": { "const": true },
            "safe_message": { "const": "Tool rate limit exceeded" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_TOOL_TIMEOUT" },
            "category": { "const": "timeout" },
            "retryable": { "const": true },
            "safe_message": { "const": "Tool call timed out" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_TOOL_CANCELLED" },
            "category": { "const": "cancelled" },
            "retryable": { "const": false },
            "safe_message": { "const": "Tool call was cancelled" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_TOOL_INTERNAL" },
            "category": { "const": "internal" },
            "retryable": { "const": false },
            "safe_message": { "const": "Tool operation failed" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_OPERATION_CONFLICT" },
            "category": { "const": "stale-revision" },
            "retryable": { "const": false },
            "safe_message": {
              "const": "Project operation conflicts with an existing operation"
            }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_PROJECT_INVALID" },
            "category": { "const": "invalid-input" },
            "retryable": { "const": false },
            "safe_message": { "const": "Project input is invalid" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_PROJECT_PATH_UNSAFE" },
            "category": { "const": "integrity" },
            "retryable": { "const": false },
            "safe_message": { "const": "Project path is unsafe" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_PROJECT_NOT_FOUND" },
            "category": { "const": "invalid-input" },
            "retryable": { "const": false },
            "safe_message": { "const": "Project registration was not found" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_PROJECT_UNAVAILABLE" },
            "category": { "const": "unavailable" },
            "retryable": { "const": true },
            "safe_message": { "const": "Project is unavailable" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_PROJECT_REGISTRY_CORRUPT" },
            "category": { "const": "integrity" },
            "retryable": { "const": false },
            "safe_message": { "const": "Project registry is corrupt" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_PROJECT_INTAKE_CORRUPT" },
            "category": { "const": "integrity" },
            "retryable": { "const": false },
            "safe_message": { "const": "Project intake state is corrupt" }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "request_id": { "type": "string", "format": "uuid" },
        "ok": { "const": true },
        "status": { "type": "object" },
        "data": { "type": "null" },
        "error": { "type": "null" }
      }
    },
    {
      "properties": {
        "request_id": { "type": "string", "format": "uuid" },
        "ok": { "const": true },
        "status": { "type": "null" },
        "data": {
          "oneOf": [
            { "$ref": "#/$defs/project_registration_data" },
            { "$ref": "#/$defs/project_list_data" },
            { "$ref": "#/$defs/superpowers_approval_data" },
            { "$ref": "#/$defs/tool_approval_data" }
          ]
        },
        "error": { "type": "null" }
      }
    },
    {
      "properties": {
        "ok": { "const": false },
        "status": { "type": "null" },
        "data": { "type": "null" },
        "error": { "type": "object" }
      }
    }
  ]
}
