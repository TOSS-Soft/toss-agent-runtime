{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/runtime/v1/service-control-response.v1.schema.json",
  "title": "TOSS local runtime service control response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "request_id", "ok", "status", "data", "error"],
  "properties": {
    "schema_version": { "const": "service-control-response.v1" },
    "document_type": { "const": "service-control-response" },
    "request_id": { "type": ["string", "null"], "format": "uuid" },
    "ok": { "type": "boolean" },
    "status": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "package_version",
        "service_instance_id",
        "pid",
        "started_at",
        "health",
        "accepting"
      ],
      "properties": {
        "package_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "service_instance_id": { "type": "string", "format": "uuid" },
        "pid": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "started_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "health": { "type": "string", "enum": ["healthy", "degraded", "stopping"] },
        "accepting": { "type": "boolean" }
      }
    },
    "data": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/project_registration_data" },
        { "$ref": "#/$defs/project_list_data" }
      ]
    },
    "error": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/service_error" }]
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "project_registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "registry_revision", "canonical_root", "manifest_hash", "state"],
      "properties": {
        "project_id": { "type": "string", "format": "uuid" },
        "registry_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "canonical_root": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "manifest_hash": { "$ref": "#/$defs/sha256" },
        "state": {
          "type": "string",
          "enum": ["ACTIVE", "UNREGISTERED", "BLOCKED_PROJECT_UNAVAILABLE"]
        }
      }
    },
    "project_registration_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "registration"],
      "properties": {
        "kind": { "const": "project-registration" },
        "registration": { "$ref": "#/$defs/project_registration" }
      }
    },
    "project_list_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "registrations"],
      "properties": {
        "kind": { "const": "project-list" },
        "registrations": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/project_registration" }
        }
      }
    },
    "service_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "retryable", "safe_message"],
      "properties": {
        "code": { "type": "string" },
        "category": { "type": "string" },
        "retryable": { "type": "boolean" },
        "safe_message": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "oneOf": [
        {
          "properties": {
            "code": { "const": "RUNTIME_SERVICE_ALREADY_RUNNING" },
            "category": { "const": "unavailable" },
            "retryable": { "const": false },
            "safe_message": { "const": "Runtime service is already running" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SERVICE_LOCK_AMBIGUOUS" },
            "category": { "const": "integrity" },
            "retryable": { "const": false },
            "safe_message": { "const": "Runtime service lock state is ambiguous" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SERVICE_PATH_UNSAFE" },
            "category": { "const": "integrity" },
            "retryable": { "const": false },
            "safe_message": { "const": "Runtime service path is unsafe" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SERVICE_DEFINITION_UNSAFE" },
            "category": { "const": "integrity" },
            "retryable": { "const": false },
            "safe_message": { "const": "Runtime service definition is unsafe" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SERVICE_MANAGER_UNAVAILABLE" },
            "category": { "const": "unavailable" },
            "retryable": { "const": false },
            "safe_message": { "const": "Runtime service manager is unavailable" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SERVICE_MANAGER_FAILED" },
            "category": { "const": "unavailable" },
            "retryable": { "const": true },
            "safe_message": { "const": "Runtime service manager failed" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SERVICE_CONTROL_INVALID" },
            "category": { "const": "invalid-input" },
            "retryable": { "const": false },
            "safe_message": { "const": "Runtime service control request is invalid" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SERVICE_CONTROL_CONFLICT" },
            "category": { "const": "stale-revision" },
            "retryable": { "const": false },
            "safe_message": {
              "const": "Runtime service control request conflicts with an existing request"
            }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_SERVICE_UNAVAILABLE" },
            "category": { "const": "unavailable" },
            "retryable": { "const": true },
            "safe_message": { "const": "Runtime service is unavailable" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_OPERATION_CONFLICT" },
            "category": { "const": "stale-revision" },
            "retryable": { "const": false },
            "safe_message": {
              "const": "Project operation conflicts with an existing operation"
            }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_PROJECT_INVALID" },
            "category": { "const": "invalid-input" },
            "retryable": { "const": false },
            "safe_message": { "const": "Project input is invalid" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_PROJECT_PATH_UNSAFE" },
            "category": { "const": "integrity" },
            "retryable": { "const": false },
            "safe_message": { "const": "Project path is unsafe" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_PROJECT_NOT_FOUND" },
            "category": { "const": "invalid-input" },
            "retryable": { "const": false },
            "safe_message": { "const": "Project registration was not found" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_PROJECT_UNAVAILABLE" },
            "category": { "const": "unavailable" },
            "retryable": { "const": true },
            "safe_message": { "const": "Project is unavailable" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_PROJECT_REGISTRY_CORRUPT" },
            "category": { "const": "integrity" },
            "retryable": { "const": false },
            "safe_message": { "const": "Project registry is corrupt" }
          }
        },
        {
          "properties": {
            "code": { "const": "RUNTIME_PROJECT_INTAKE_CORRUPT" },
            "category": { "const": "integrity" },
            "retryable": { "const": false },
            "safe_message": { "const": "Project intake state is corrupt" }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "request_id": { "type": "string", "format": "uuid" },
        "ok": { "const": true },
        "status": { "type": "object" },
        "data": { "type": "null" },
        "error": { "type": "null" }
      }
    },
    {
      "properties": {
        "request_id": { "type": "string", "format": "uuid" },
        "ok": { "const": true },
        "status": { "type": "null" },
        "data": {
          "oneOf": [
            { "$ref": "#/$defs/project_registration_data" },
            { "$ref": "#/$defs/project_list_data" }
          ]
        },
        "error": { "type": "null" }
      }
    },
    {
      "properties": {
        "ok": { "const": false },
        "status": { "type": "null" },
        "data": { "type": "null" },
        "error": { "type": "object" }
      }
    }
  ]
}
