{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json",
  "title": "TOSS Runtime Contract Protocol v1 common definitions",
  "$defs": {
    "document_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "relative_location": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_type", "artifact_id", "revision", "hash"],
      "properties": {
        "document_type": { "$ref": "#/$defs/document_type" },
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "hash": { "$ref": "#/$defs/sha256" },
        "location": { "$ref": "#/$defs/relative_location" }
      }
    },
    "producer_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version"],
      "properties": {
        "kind": { "type": "string", "enum": ["runtime", "gateway", "provider", "skill", "tool"] },
        "name": { "$ref": "#/$defs/identifier" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "trace_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_id", "span_id", "trace_flags"],
      "properties": {
        "trace_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "span_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "trace_flags": { "type": "integer", "minimum": 0, "maximum": 255 },
        "trace_state": { "type": "string", "maxLength": 512 }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_input_tokens",
        "max_output_tokens",
        "max_cost_microusd",
        "max_duration_ms",
        "max_turns"
      ],
      "properties": {
        "max_input_tokens": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "max_output_tokens": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
        "max_cost_microusd": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "max_duration_ms": { "type": "integer", "minimum": 1, "maximum": 604800000 },
        "max_turns": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "cost_microusd", "duration_ms", "turns"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "output_tokens": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "cost_microusd": { "type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991 },
        "duration_ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "turns": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "safe_metadata_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {
        "pattern": "(?:^|[_-])(?:authority|approved|accepted|credential|secret|token|password|api[_-]?key|environment)(?:$|[_-])"
      }
    },
    "safe_json": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 65536 },
        {
          "type": "array",
          "maxItems": 10000,
          "items": { "$ref": "#/$defs/safe_json" }
        },
        {
          "type": "object",
          "maxProperties": 10000,
          "propertyNames": { "$ref": "#/$defs/safe_metadata_key" },
          "additionalProperties": { "$ref": "#/$defs/safe_json" }
        }
      ]
    },
    "runtime_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "retryable", "safe_message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" },
        "category": {
          "type": "string",
          "enum": [
            "invalid-input",
            "stale-revision",
            "unsupported-capability",
            "policy-denied",
            "approval-required",
            "authentication",
            "rate-limit",
            "refusal",
            "timeout",
            "cancelled",
            "unavailable",
            "integrity",
            "internal"
          ]
        },
        "retryable": { "type": "boolean" },
        "safe_message": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "metadata": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": { "$ref": "#/$defs/safe_metadata_key" },
          "additionalProperties": { "$ref": "#/$defs/safe_json" }
        }
      }
    }
  }
}
