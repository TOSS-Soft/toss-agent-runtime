{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/runtime/v1/candidate-job-intent.v1.schema.json",
  "title": "TOSS candidate job intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "schema_version",
    "document_type",
    "candidate_key",
    "kind",
    "project_id",
    "registry_revision",
    "manifest_hash",
    "changes",
    "created_at"
  ],
  "properties": {
    "protocol_version": { "const": "runtime-contract.v1" },
    "schema_version": { "const": "candidate-job-intent.v1" },
    "document_type": { "const": "candidate-job-intent" },
    "candidate_key": { "$ref": "#/$defs/sha256" },
    "kind": { "const": "PROJECT_CHANGED" },
    "project_id": { "type": "string", "format": "uuid" },
    "registry_revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "manifest_hash": { "$ref": "#/$defs/sha256" },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/change" }
    },
    "created_at": { "type": "string", "format": "date-time", "pattern": "Z$" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device", "inode", "mtime_ns", "size"],
      "properties": {
        "device": { "$ref": "#/$defs/decimal" },
        "inode": { "$ref": "#/$defs/decimal" },
        "mtime_ns": { "$ref": "#/$defs/decimal" },
        "size": { "$ref": "#/$defs/decimal" }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "identity"],
      "properties": {
        "kind": { "type": "string", "enum": ["CREATED", "CHANGED", "REMOVED"] },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "identity": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/identity" }] }
      }
    }
  }
}
