{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/runtime/v1/agentgateway-capabilities.v1.schema.json",
  "title": "TOSS agentgateway capabilities v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "schema_version",
    "document_type",
    "gateway",
    "generated_at",
    "expires_at",
    "routes",
    "document_hash"
  ],
  "properties": {
    "protocol_version": { "const": "runtime-contract.v1" },
    "schema_version": { "const": "agentgateway-capabilities.v1" },
    "document_type": { "const": "agentgateway-capabilities" },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "revision"],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "revision": { "$ref": "#/$defs/nonnegative" }
      }
    },
    "generated_at": {
      "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/utc_timestamp"
    },
    "expires_at": {
      "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/utc_timestamp"
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/route" }
    },
    "document_hash": {
      "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/sha256"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "model": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "provider": {
      "type": "string",
      "enum": ["openai", "anthropic", "gemini"]
    },
    "nonnegative": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positive_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "tools",
        "json_schema",
        "vision",
        "reasoning",
        "streaming",
        "max_context_tokens",
        "max_output_tokens"
      ],
      "properties": {
        "provider": { "$ref": "#/$defs/provider" },
        "tools": { "type": "boolean" },
        "json_schema": { "type": "boolean" },
        "vision": { "type": "boolean" },
        "reasoning": { "type": "boolean" },
        "streaming": { "type": "boolean" },
        "max_context_tokens": { "$ref": "#/$defs/positive_limit" },
        "max_output_tokens": { "$ref": "#/$defs/positive_limit" }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "route_id", "provider", "model", "capabilities"],
      "properties": {
        "alias": { "$ref": "#/$defs/identifier" },
        "route_id": { "$ref": "#/$defs/identifier" },
        "provider": { "$ref": "#/$defs/provider" },
        "model": { "$ref": "#/$defs/model" },
        "capabilities": { "$ref": "#/$defs/capabilities" }
      }
    }
  }
}
