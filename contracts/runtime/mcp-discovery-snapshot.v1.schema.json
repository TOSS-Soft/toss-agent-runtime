{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/runtime/v1/mcp-discovery-snapshot.v1.schema.json",
  "title": "TOSS MCP discovery snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "schema_version",
    "document_type",
    "run_id",
    "session_id",
    "execution_request_hash",
    "profile",
    "created_at",
    "expires_at",
    "stale",
    "servers",
    "document_hash"
  ],
  "properties": {
    "protocol_version": { "const": "runtime-contract.v1" },
    "schema_version": { "const": "mcp-discovery-snapshot.v1" },
    "document_type": { "const": "mcp-discovery-snapshot" },
    "run_id": { "$ref": "runtime-common.v1.schema.json#/$defs/identifier" },
    "session_id": { "$ref": "runtime-common.v1.schema.json#/$defs/identifier" },
    "execution_request_hash": { "$ref": "runtime-common.v1.schema.json#/$defs/sha256" },
    "profile": { "$ref": "#/$defs/mcp_profile_reference" },
    "created_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "expires_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "stale": { "type": "boolean" },
    "servers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/server" }
    },
    "document_hash": { "$ref": "runtime-common.v1.schema.json#/$defs/sha256" }
  },
  "$defs": {
    "mcp_profile_reference": {
      "allOf": [
        { "$ref": "runtime-common.v1.schema.json#/$defs/artifact_reference" },
        { "type": "object", "properties": { "document_type": { "const": "mcp-profile" } } }
      ]
    },
    "nullable_boolean": {
      "oneOf": [{ "type": "boolean" }, { "type": "null" }]
    },
    "annotations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_only_hint", "destructive_hint", "idempotent_hint", "open_world_hint"],
      "properties": {
        "read_only_hint": { "$ref": "#/$defs/nullable_boolean" },
        "destructive_hint": { "$ref": "#/$defs/nullable_boolean" },
        "idempotent_hint": { "$ref": "#/$defs/nullable_boolean" },
        "open_world_hint": { "$ref": "#/$defs/nullable_boolean" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias",
        "native_name",
        "input_schema_hash",
        "output_schema_hash",
        "operation_class",
        "annotations"
      ],
      "properties": {
        "alias": { "$ref": "runtime-common.v1.schema.json#/$defs/identifier" },
        "native_name": { "$ref": "runtime-common.v1.schema.json#/$defs/identifier" },
        "input_schema_hash": { "$ref": "runtime-common.v1.schema.json#/$defs/sha256" },
        "output_schema_hash": {
          "oneOf": [{ "type": "null" }, { "$ref": "runtime-common.v1.schema.json#/$defs/sha256" }]
        },
        "operation_class": {
          "enum": ["read-only", "reversible-write", "irreversible"]
        },
        "annotations": { "$ref": "#/$defs/annotations" }
      }
    },
    "server_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "identity_hash"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "identity_hash": { "$ref": "runtime-common.v1.schema.json#/$defs/sha256" }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server_id",
        "binding_name",
        "transport",
        "protocol_revision",
        "server",
        "tools"
      ],
      "properties": {
        "server_id": { "$ref": "runtime-common.v1.schema.json#/$defs/identifier" },
        "binding_name": { "$ref": "runtime-common.v1.schema.json#/$defs/identifier" },
        "transport": { "enum": ["stdio", "streamable-http", "agentgateway"] },
        "protocol_revision": { "enum": ["2025-06-18", "2026-07-28"] },
        "server": { "$ref": "#/$defs/server_identity" },
        "tools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/tool" }
        }
      }
    }
  }
}
