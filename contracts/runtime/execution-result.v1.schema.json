{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/runtime/v1/execution-result.v1.schema.json",
  "title": "TOSS Runtime execution result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "schema_version",
    "document_type",
    "run_id",
    "request_hash",
    "journal_head",
    "status",
    "finished_at",
    "outputs",
    "error",
    "usage",
    "evidence",
    "trace"
  ],
  "properties": {
    "protocol_version": { "const": "runtime-contract.v1" },
    "schema_version": { "const": "execution-result.v1" },
    "document_type": { "const": "execution-result" },
    "run_id": {
      "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/identifier"
    },
    "request_hash": {
      "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/sha256"
    },
    "journal_head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "run_revision", "event_hash"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "run_revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "event_hash": {
          "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["COMPLETED", "FAILED", "BLOCKED", "CANCELLED", "INTERRUPTED"]
    },
    "finished_at": {
      "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/utc_timestamp"
    },
    "outputs": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/artifact_reference"
      }
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/runtime_error"
        }
      ]
    },
    "usage": {
      "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/usage"
    },
    "evidence": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/artifact_reference"
      }
    },
    "trace": {
      "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/trace_context"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "COMPLETED" } }, "required": ["status"] },
      "then": {
        "properties": {
          "outputs": { "type": "array", "minItems": 1 },
          "error": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "outputs": { "type": "array", "maxItems": 0 },
          "error": {
            "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/runtime_error"
          }
        }
      }
    }
  ]
}
