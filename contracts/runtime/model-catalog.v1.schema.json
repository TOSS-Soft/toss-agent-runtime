{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/runtime/v1/model-catalog.v1.schema.json",
  "title": "TOSS model catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "schema_version",
    "document_type",
    "catalog_id",
    "revision",
    "entries",
    "document_hash"
  ],
  "properties": {
    "protocol_version": { "const": "runtime-contract.v1" },
    "schema_version": { "const": "model-catalog.v1" },
    "document_type": { "const": "model-catalog" },
    "catalog_id": {
      "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/identifier"
    },
    "revision": { "$ref": "#/$defs/positive_safe_integer" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/entry" }
    },
    "document_hash": {
      "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/sha256"
    }
  },
  "$defs": {
    "positive_safe_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nonnegative_safe_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_id", "logical_classes", "route_alias", "priority", "routes"],
      "properties": {
        "entry_id": {
          "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/identifier"
        },
        "logical_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "economy",
              "balanced-code",
              "deep-reasoning",
              "long-context",
              "vision",
              "independent-review"
            ]
          }
        },
        "route_alias": {
          "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/identifier"
        },
        "priority": { "$ref": "#/$defs/nonnegative_safe_integer" },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/route" }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "provider", "model", "capabilities", "latency_class", "pricing"],
      "properties": {
        "route_id": {
          "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/identifier"
        },
        "provider": {
          "$ref": "https://toss.software/schemas/runtime/v1/agentgateway-capabilities.v1.schema.json#/$defs/provider"
        },
        "model": {
          "$ref": "https://toss.software/schemas/runtime/v1/agentgateway-capabilities.v1.schema.json#/$defs/model"
        },
        "capabilities": {
          "$ref": "https://toss.software/schemas/runtime/v1/agentgateway-capabilities.v1.schema.json#/$defs/capabilities"
        },
        "latency_class": {
          "type": "string",
          "enum": ["interactive", "standard", "extended"]
        },
        "pricing": { "$ref": "#/$defs/pricing" }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_microusd_per_million",
        "cached_input_microusd_per_million",
        "output_microusd_per_million",
        "reasoning_output_microusd_per_million"
      ],
      "properties": {
        "input_microusd_per_million": { "$ref": "#/$defs/nonnegative_safe_integer" },
        "cached_input_microusd_per_million": { "$ref": "#/$defs/nonnegative_safe_integer" },
        "output_microusd_per_million": { "$ref": "#/$defs/nonnegative_safe_integer" },
        "reasoning_output_microusd_per_million": { "$ref": "#/$defs/nonnegative_safe_integer" }
      }
    }
  }
}
