{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/runtime/v1/runtime-config.v1.schema.json",
  "title": "TOSS Runtime configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "mode",
    "paths",
    "shutdown_timeout_ms",
    "logs",
    "gateway_profile",
    "gateway_profiles",
    "provider_profiles",
    "mcp_profiles",
    "skill_roots",
    "secret_references"
  ],
  "properties": {
    "schema_version": { "const": "runtime-config.v1" },
    "document_type": { "const": "runtime-config" },
    "mode": { "type": "string", "enum": ["development", "production"] },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "logs", "socket"],
      "properties": {
        "state": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "logs": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "socket": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    },
    "shutdown_timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 300000 },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "retention_days", "max_bytes"],
      "properties": {
        "level": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "retention_days": { "const": 7 },
        "max_bytes": { "const": 104857600 }
      }
    },
    "gateway_profile": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "gateway_profiles": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocol", "endpoint", "credential_reference", "body_observability"],
        "properties": {
          "protocol": { "const": "toss-agentgateway.v1" },
          "endpoint": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "credential_reference": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
          },
          "body_observability": {
            "type": "string",
            "enum": ["off", "redacted-metadata"]
          }
        }
      }
    },
    "provider_profiles": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" }
    },
    "mcp_profiles": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" },
      "additionalProperties": { "$ref": "#/$defs/mcp_profile_config" }
    },
    "skill_roots": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "secret_references": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "key"],
        "properties": {
          "source": { "type": "string", "enum": ["env", "command"] },
          "key": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$" }
        }
      }
    }
  },
  "$defs": {
    "mcp_environment_value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "literal" },
            "value": { "type": "string", "maxLength": 4096 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reference"],
          "properties": {
            "kind": { "const": "secret-reference" },
            "reference": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" }
          }
        }
      ]
    },
    "mcp_stdio_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "command", "args", "cwd", "environment"],
      "properties": {
        "transport": { "const": "stdio" },
        "command": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "args": {
          "type": "array",
          "maxItems": 128,
          "items": { "type": "string", "maxLength": 4096 }
        },
        "cwd": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "environment": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$" },
          "additionalProperties": { "$ref": "#/$defs/mcp_environment_value" }
        }
      }
    },
    "mcp_http_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "endpoint", "credential_reference"],
      "properties": {
        "transport": { "const": "streamable-http" },
        "endpoint": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "credential_reference": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" }
          ]
        }
      }
    },
    "mcp_agentgateway_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "gateway_profile"],
      "properties": {
        "transport": { "const": "agentgateway" },
        "gateway_profile": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" }
      }
    },
    "mcp_binding": {
      "oneOf": [
        { "$ref": "#/$defs/mcp_stdio_binding" },
        { "$ref": "#/$defs/mcp_http_binding" },
        { "$ref": "#/$defs/mcp_agentgateway_binding" }
      ]
    },
    "mcp_profile_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "servers"],
      "properties": {
        "profile": { "$ref": "mcp-profile.v1.schema.json" },
        "servers": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" },
          "additionalProperties": { "$ref": "#/$defs/mcp_binding" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "production" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "gateway_profile": { "type": "string", "minLength": 1 },
          "provider_profiles": { "type": "array", "maxItems": 0 }
        }
      }
    }
  ]
}
