{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/runtime/v1/operational-event.v1.schema.json",
  "title": "TOSS operational event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "schema_version",
    "document_type",
    "event_id",
    "timestamp",
    "service_instance_id",
    "service_sequence",
    "level",
    "component",
    "event",
    "correlation_id",
    "metadata"
  ],
  "properties": {
    "protocol_version": { "const": "runtime-contract.v1" },
    "schema_version": { "const": "operational-event.v1" },
    "document_type": { "const": "operational-event" },
    "event_id": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "service_instance_id": { "type": "string", "format": "uuid" },
    "service_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "level": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
    "component": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "event": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "project_id": { "type": "string", "format": "uuid" },
    "job_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "format": "uuid" },
    "metadata": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "oneOf": [
          { "type": "null" },
          { "type": "boolean" },
          { "type": "number" },
          { "type": "string", "maxLength": 1024 }
        ]
      }
    }
  }
}
