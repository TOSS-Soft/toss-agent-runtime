{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/runtime/v1/service-lock.v1.schema.json",
  "title": "TOSS local runtime service lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "service_instance_id",
    "pid",
    "executable_hash",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "service-lock.v1" },
    "document_type": { "const": "service-lock" },
    "service_instance_id": { "type": "string", "format": "uuid" },
    "pid": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "executable_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "created_at": { "type": "string", "format": "date-time", "pattern": "Z$" }
  }
}
