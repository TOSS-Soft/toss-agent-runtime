{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/runtime/v1/skill-execution-evidence.v1.schema.json",
  "title": "TOSS skill execution evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "schema_version", "document_type", "run_id", "catalog_hash", "skill", "resource_hashes", "phases", "approvals", "context_hashes", "handoff_hash", "terminal_code", "document_hash"],
  "properties": {
    "protocol_version": { "const": "runtime-contract.v1" }, "schema_version": { "const": "skill-execution-evidence.v1" }, "document_type": { "const": "skill-execution-evidence" }, "run_id": { "$ref": "runtime-common.v1.schema.json#/$defs/identifier" }, "catalog_hash": { "$ref": "runtime-common.v1.schema.json#/$defs/sha256" }, "skill": { "$ref": "#/$defs/skill" }, "resource_hashes": { "type": "array", "maxItems": 256, "items": { "$ref": "runtime-common.v1.schema.json#/$defs/sha256" } }, "phases": { "type": "array", "maxItems": 7, "items": { "$ref": "#/$defs/phase" } }, "approvals": { "type": "array", "maxItems": 7, "items": { "$ref": "#/$defs/approval" } }, "context_hashes": { "type": "array", "maxItems": 256, "items": { "$ref": "runtime-common.v1.schema.json#/$defs/sha256" } }, "handoff_hash": { "$ref": "runtime-common.v1.schema.json#/$defs/sha256" }, "terminal_code": { "oneOf": [{ "type": "null" }, { "enum": ["BLOCKED_SUPERPOWERS_MISSING", "RUNTIME_SKILL_INVALID", "RUNTIME_SKILL_PATH_UNSAFE", "RUNTIME_SKILL_INTEGRITY", "RUNTIME_SKILL_LIMIT_EXCEEDED", "RUNTIME_SKILL_CONTEXT_OVERFLOW", "RUNTIME_SKILL_SCRIPT_UNAVAILABLE", "RUNTIME_SKILL_STALE_STATE", "RUNTIME_SKILL_OPERATION_CONFLICT", "RUNTIME_SKILL_UNAVAILABLE"] }] }, "document_hash": { "$ref": "runtime-common.v1.schema.json#/$defs/sha256" }
  },
  "$defs": {
    "source": { "type": "object", "additionalProperties": false, "required": ["kind", "identity"], "properties": { "kind": { "enum": ["configured", "bundled"] }, "identity": { "$ref": "runtime-common.v1.schema.json#/$defs/identifier" } } },
    "skill": { "type": "object", "additionalProperties": false, "required": ["name", "version", "source", "package_hash", "document_hash", "snapshot_hash"], "properties": { "name": { "$ref": "runtime-common.v1.schema.json#/$defs/identifier" }, "version": { "type": "string", "minLength": 1, "maxLength": 128 }, "source": { "$ref": "#/$defs/source" }, "package_hash": { "$ref": "runtime-common.v1.schema.json#/$defs/sha256" }, "document_hash": { "$ref": "runtime-common.v1.schema.json#/$defs/sha256" }, "snapshot_hash": { "$ref": "runtime-common.v1.schema.json#/$defs/sha256" } } },
    "phase": { "type": "object", "additionalProperties": false, "required": ["phase", "handler_hash", "phase_hash", "input_hash", "output_hash"], "properties": { "phase": { "enum": ["BRAINSTORMING", "TEST_DESIGN", "RED", "GREEN", "DEBUGGING", "REVIEW", "VERIFICATION"] }, "handler_hash": { "$ref": "runtime-common.v1.schema.json#/$defs/sha256" }, "phase_hash": { "$ref": "runtime-common.v1.schema.json#/$defs/sha256" }, "input_hash": { "$ref": "runtime-common.v1.schema.json#/$defs/sha256" }, "output_hash": { "oneOf": [{ "$ref": "runtime-common.v1.schema.json#/$defs/sha256" }, { "type": "null" }] } } },
    "positive_integer": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "journal_head": { "type": "object", "additionalProperties": false, "required": ["journal_revision", "sequence", "entry_hash"], "properties": { "journal_revision": { "$ref": "#/$defs/positive_integer" }, "sequence": { "$ref": "#/$defs/positive_integer" }, "entry_hash": { "$ref": "runtime-common.v1.schema.json#/$defs/sha256" } } },
    "approval": { "type": "object", "additionalProperties": false, "required": ["request_hash", "decision_hash", "journal_head"], "properties": { "request_hash": { "$ref": "runtime-common.v1.schema.json#/$defs/sha256" }, "decision_hash": { "oneOf": [{ "$ref": "runtime-common.v1.schema.json#/$defs/sha256" }, { "type": "null" }] }, "journal_head": { "$ref": "#/$defs/journal_head" } } }
  }
}
