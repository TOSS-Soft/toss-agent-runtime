{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/runtime/v1/provider-event.v1.schema.json",
  "title": "TOSS normalized provider event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "schema_version",
    "document_type",
    "event_id",
    "request_id",
    "sequence",
    "occurred_at",
    "provider",
    "model",
    "event_type",
    "provenance",
    "data"
  ],
  "properties": {
    "protocol_version": { "const": "runtime-contract.v1" },
    "schema_version": { "const": "provider-event.v1" },
    "document_type": { "const": "provider-event" },
    "event_id": { "type": "string", "format": "uuid" },
    "request_id": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "provider": { "type": "string", "enum": ["openai", "anthropic", "gemini"] },
    "model": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "response-start",
        "content-delta",
        "tool-call-delta",
        "usage",
        "response-completed",
        "response-error"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_event", "lossy_fields"],
      "properties": {
        "native_event": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "lossy_fields": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!.*(?:authorization|authority|credential|password|secret|api[_-]?key|private[_-]?key|token))[a-z][a-z0-9_.-]{0,127}$"
          }
        }
      }
    },
    "data": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "event_type": { "const": "response-start" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/start" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "content-delta" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/content_delta" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "tool-call-delta" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/tool_call_delta" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "usage" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/usage" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "response-completed" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/completed" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "response-error" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/error" } } }
    }
  ],
  "$defs": {
    "safe_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$" },
    "nonnegative": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "response_id": { "$ref": "#/$defs/safe_id" } }
    },
    "content_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "index", "delta"],
      "properties": {
        "channel": { "type": "string", "enum": ["text", "reasoning", "refusal"] },
        "index": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "delta": { "type": "string", "minLength": 1, "maxLength": 1048576 }
      }
    },
    "tool_call_delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "tool_call_id", "arguments_delta"],
      "properties": {
        "index": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "tool_call_id": { "$ref": "#/$defs/safe_id" },
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]{0,127}$" },
        "arguments_delta": { "type": "string", "maxLength": 1048576 }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "cached_input_tokens", "reasoning_tokens"],
      "properties": {
        "input_tokens": { "$ref": "#/$defs/nonnegative" },
        "output_tokens": { "$ref": "#/$defs/nonnegative" },
        "cached_input_tokens": {
          "anyOf": [{ "$ref": "#/$defs/nonnegative" }, { "type": "null" }]
        },
        "reasoning_tokens": {
          "anyOf": [{ "$ref": "#/$defs/nonnegative" }, { "type": "null" }]
        }
      }
    },
    "completed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finish_reason"],
      "properties": {
        "finish_reason": {
          "type": "string",
          "enum": ["stop", "length", "tool-calls", "refusal", "content-filter", "cancelled"]
        },
        "structured_output": {}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "$ref": "https://toss.software/schemas/runtime/v1/runtime-common.v1.schema.json#/$defs/runtime_error"
        }
      }
    }
  }
}
