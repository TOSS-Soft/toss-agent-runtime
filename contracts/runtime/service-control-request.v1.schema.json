{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/runtime/v1/service-control-request.v1.schema.json",
  "title": "TOSS local runtime service control request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "request_id", "command"],
  "properties": {
    "schema_version": { "const": "service-control-request.v1" },
    "document_type": { "const": "service-control-request" },
    "request_id": { "type": "string", "format": "uuid" },
    "command": {
      "type": "string",
      "enum": ["status", "project-register", "project-unregister", "project-list"]
    },
    "root": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "project_id": { "type": "string", "format": "uuid" }
  },
  "oneOf": [
    {
      "properties": {
        "command": { "const": "status" },
        "root": false,
        "project_id": false
      }
    },
    {
      "required": ["root"],
      "properties": {
        "command": { "const": "project-register" },
        "project_id": false
      }
    },
    {
      "required": ["project_id"],
      "properties": {
        "command": { "const": "project-unregister" },
        "root": false
      }
    },
    {
      "properties": {
        "command": { "const": "project-list" },
        "root": false,
        "project_id": false
      }
    }
  ]
}
