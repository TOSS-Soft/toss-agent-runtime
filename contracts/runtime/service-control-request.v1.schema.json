{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/runtime/v1/service-control-request.v1.schema.json",
  "title": "TOSS local runtime service control request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "request_id", "command"],
  "properties": {
    "schema_version": { "const": "service-control-request.v1" },
    "document_type": { "const": "service-control-request" },
    "request_id": { "type": "string", "format": "uuid" },
    "operation_id": { "type": "string", "format": "uuid" },
    "command": {
      "type": "string",
      "enum": [
        "status",
        "project-register",
        "project-unregister",
        "project-list",
        "superpowers-approve",
        "tool-approve"
      ]
    },
    "root": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "project_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" },
    "call_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" },
    "expected_journal_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expected_journal_head_hash": { "$ref": "#/$defs/sha256" },
    "phase": { "$ref": "#/$defs/phase" },
    "skill_name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$" },
    "skill_version": { "$ref": "#/$defs/semver" },
    "skill_snapshot_hash": { "$ref": "#/$defs/sha256" },
    "approval_request_hash": { "$ref": "#/$defs/sha256" },
    "decision": { "enum": ["APPROVE", "REJECT"] }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "semver": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "phase": {
      "enum": [
        "BRAINSTORMING",
        "TEST_DESIGN",
        "RED",
        "GREEN",
        "DEBUGGING",
        "REVIEW",
        "VERIFICATION"
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "command": { "const": "status" },
        "operation_id": false,
        "root": false,
        "project_id": false,
        "run_id": false,
        "call_id": false,
        "expected_journal_revision": false,
        "expected_journal_head_hash": false,
        "phase": false,
        "skill_name": false,
        "skill_version": false,
        "skill_snapshot_hash": false,
        "approval_request_hash": false,
        "decision": false
      }
    },
    {
      "required": ["operation_id", "root"],
      "properties": {
        "command": { "const": "project-register" },
        "project_id": false,
        "run_id": false,
        "call_id": false,
        "expected_journal_revision": false,
        "expected_journal_head_hash": false,
        "phase": false,
        "skill_name": false,
        "skill_version": false,
        "skill_snapshot_hash": false,
        "approval_request_hash": false,
        "decision": false
      }
    },
    {
      "required": ["operation_id", "project_id"],
      "properties": {
        "command": { "const": "project-unregister" },
        "root": false,
        "run_id": false,
        "call_id": false,
        "expected_journal_revision": false,
        "expected_journal_head_hash": false,
        "phase": false,
        "skill_name": false,
        "skill_version": false,
        "skill_snapshot_hash": false,
        "approval_request_hash": false,
        "decision": false
      }
    },
    {
      "properties": {
        "command": { "const": "project-list" },
        "operation_id": false,
        "root": false,
        "project_id": false,
        "run_id": false,
        "call_id": false,
        "expected_journal_revision": false,
        "expected_journal_head_hash": false,
        "phase": false,
        "skill_name": false,
        "skill_version": false,
        "skill_snapshot_hash": false,
        "approval_request_hash": false,
        "decision": false
      }
    },
    {
      "required": [
        "operation_id",
        "run_id",
        "expected_journal_revision",
        "expected_journal_head_hash",
        "phase",
        "skill_name",
        "skill_version",
        "skill_snapshot_hash",
        "approval_request_hash",
        "decision"
      ],
      "properties": {
        "command": { "const": "superpowers-approve" },
        "root": false,
        "project_id": false,
        "call_id": false
      }
    },
    {
      "required": [
        "operation_id",
        "run_id",
        "expected_journal_revision",
        "expected_journal_head_hash",
        "call_id",
        "approval_request_hash",
        "decision"
      ],
      "properties": {
        "command": { "const": "tool-approve" },
        "root": false,
        "project_id": false,
        "phase": false,
        "skill_name": false,
        "skill_version": false,
        "skill_snapshot_hash": false
      }
    }
  ]
}
