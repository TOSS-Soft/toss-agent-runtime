{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss.software/schemas/runtime/v1/prompt-template.v1.schema.json",
  "title": "TOSS prompt template v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "schema_version",
    "document_type",
    "template_id",
    "revision",
    "instruction_blocks",
    "document_hash"
  ],
  "properties": {
    "protocol_version": { "const": "runtime-contract.v1" },
    "schema_version": { "const": "prompt-template.v1" },
    "document_type": { "const": "prompt-template" },
    "template_id": { "$ref": "runtime-common.v1.schema.json#/$defs/identifier" },
    "revision": { "$ref": "#/$defs/positive_safe_integer" },
    "instruction_blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/instruction_block" }
    },
    "document_hash": { "$ref": "runtime-common.v1.schema.json#/$defs/sha256" }
  },
  "$defs": {
    "positive_safe_integer": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "instruction_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "content"],
      "properties": {
        "block_id": { "$ref": "runtime-common.v1.schema.json#/$defs/identifier" },
        "content": { "type": "string", "minLength": 1, "maxLength": 65536 }
      }
    }
  }
}
